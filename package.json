{
  "name": "dsh-menu-hidden",
  "version": "0.2.28",
  "description": "懒人菜单：1. 应用菜单增加刷新与重启功能。 2. 新模型自动补足推理等级、上下文窗口和图片支持。 3. 侧边栏、账号菜单、模型配置等多项隐藏。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "menu",
    "hide",
    "reasoning"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json",
    "./icon": {
      "default": "./icon.svg"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "reasoning.js",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "locale/*.json",
    "shell/"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "descriptionEn": "Lazy Menu: 1. Reload and Restart in the app menu. 2. Reasoning levels, context window and image input auto-filled for new models. 3. Sidebar, account-menu and model-picker items can be hidden.",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Biu-Bong/dsh-menu-hidden.git"
  },
  "homepage": "https://github.com/Biu-Bong/dsh-menu-hidden#readme",
  "bugs": {
    "url": "https://github.com/Biu-Bong/dsh-menu-hidden/issues"
  }
}
